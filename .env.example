# ---------------------------------------------------------------------------
# Alpaca paper-trading analyser — example configuration.
# Copy to .env and fill in your own PAPER keys. Never commit the real .env.
# Get paper keys at https://app.alpaca.markets/paper/dashboard/overview
# ---------------------------------------------------------------------------

# --- Credentials (placeholders only) ---------------------------------------
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# --- Safety ----------------------------------------------------------------
# The application refuses to start unless this is true. Live trading is not
# implemented; setting this to false does not enable it, it stops the app.
ALPACA_PAPER=true

# Paper orders stay disabled until you deliberately turn them on.
ENABLE_PAPER_ORDERS=false

# Emergency stop. true blocks every order regardless of any other setting.
KILL_SWITCH=false

# --- Universe and data -----------------------------------------------------
WATCHLIST=AAPL,MSFT,NVDA,SPY
BENCHMARK_SYMBOL=SPY
# iex (free) or sip (paid subscription required)
ALPACA_DATA_FEED=iex
BAR_MINUTES=10
HISTORY_DAYS=180

# --- Freshness -------------------------------------------------------------
# Seconds to wait after a bar closes before analysing it.
BAR_SETTLE_SECONDS=45
# Reject data older than this (seconds).
MAX_DATA_AGE_SECONDS=1800

# --- Prediction horizon ----------------------------------------------------
# 39 ten-minute bars = one regular session = next-trading-day horizon.
# Signals are still recomputed every 10 minutes.
PREDICTION_HORIZON_BARS=39
ESTIMATED_SPREAD_BPS=3.0
ESTIMATED_SLIPPAGE_BPS=2.0
LABEL_THRESHOLD_BPS=0.0

# --- Model / validation ----------------------------------------------------
WALKFORWARD_SPLITS=5
MIN_TRAINING_ROWS=750
MIN_CONFIDENCE=0.58
UNCERTAINTY_MAX=0.18
RETRAIN_INTERVAL_HOURS=24

# --- Risk limits -----------------------------------------------------------
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_EXPOSURE_PCT=0.60
MAX_DAILY_LOSS_PCT=0.02
RISK_PER_TRADE_PCT=0.005
MAX_SPREAD_BPS=25.0
MIN_AVG_DOLLAR_VOLUME=5000000
MIN_ORDER_NOTIONAL=50
DUPLICATE_ORDER_WINDOW_MINUTES=60

# --- News (market-wide) ----------------------------------------------------
# News is collected for EVERY US symbol Alpaca covers, not just WATCHLIST.
NEWS_ENABLED=true
# Trailing window for a backfill, and the resume floor for incremental runs.
NEWS_BACKFILL_DAYS=7
# Articles per request page (Alpaca caps this at 50) and the page budget.
# NEWS_PAGE_LIMIT * NEWS_MAX_PAGES is the hard article cap per ingest run;
# hitting it is recorded as a truncated window rather than silently dropped.
NEWS_PAGE_LIMIT=50
NEWS_MAX_PAGES=40
# Full article bodies are large and not used by any feature.
NEWS_INCLUDE_CONTENT=false
NEWS_EXCLUDE_CONTENTLESS=false

# --- Dynamic analysis universe --------------------------------------------
# News collection is market-wide; analysis is not, because each analysed
# symbol needs its own walk-forward-validated model. These settings control
# how far beyond WATCHLIST the analysis reaches.
DYNAMIC_UNIVERSE_ENABLED=true
# Ceiling on news-driven symbols analysed per cycle, on top of WATCHLIST.
MAX_DYNAMIC_SYMBOLS=40
# Articles needed in the lookback window before a symbol is a candidate.
MIN_NEWS_FOR_CANDIDATE=2
CANDIDATE_LOOKBACK_HOURS=48
UNIVERSE_REFRESH_HOURS=12
# Models one cycle may train. A freshly widened universe fills in over several
# cycles rather than overrunning the 10-minute budget; until a symbol has a
# validated model it reports INSUFFICIENT EVIDENCE.
MAX_TRAININGS_PER_CYCLE=5

# --- Infrastructure --------------------------------------------------------
DATABASE_PATH=data/stockbot.sqlite
MODEL_DIR=models_store
LOG_DIR=logs
LOG_LEVEL=INFO
TIMEZONE=America/New_York
SCHEDULER_INTERVAL_MINUTES=10
