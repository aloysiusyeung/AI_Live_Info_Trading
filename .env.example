# ---------------------------------------------------------------------------
# Alpaca paper-trading analyser — example configuration.
# Copy to .env and fill in your own PAPER keys. Never commit the real .env.
# Get paper keys at https://app.alpaca.markets/paper/dashboard/overview
# ---------------------------------------------------------------------------

# --- Credentials (placeholders only) ---------------------------------------
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# --- Safety ----------------------------------------------------------------
# The application refuses to start unless this is true. Live trading is not
# implemented; setting this to false does not enable it, it stops the app.
ALPACA_PAPER=true

# Paper orders stay disabled until you deliberately turn them on.
ENABLE_PAPER_ORDERS=false

# Emergency stop. true blocks every order regardless of any other setting.
KILL_SWITCH=false

# --- Universe and data -----------------------------------------------------
WATCHLIST=AAPL,MSFT,NVDA,SPY
BENCHMARK_SYMBOL=SPY
# iex (free) or sip (paid subscription required)
ALPACA_DATA_FEED=iex
BAR_MINUTES=10
HISTORY_DAYS=180

# --- Freshness -------------------------------------------------------------
# Seconds to wait after a bar closes before analysing it.
BAR_SETTLE_SECONDS=45
# Reject data older than this (seconds).
MAX_DATA_AGE_SECONDS=1800

# --- Prediction horizon ----------------------------------------------------
# 39 ten-minute bars = one regular session = next-trading-day horizon.
# Signals are still recomputed every 10 minutes.
PREDICTION_HORIZON_BARS=39
ESTIMATED_SPREAD_BPS=3.0
ESTIMATED_SLIPPAGE_BPS=2.0
LABEL_THRESHOLD_BPS=0.0

# --- Model / validation ----------------------------------------------------
WALKFORWARD_SPLITS=5
MIN_TRAINING_ROWS=750
MIN_CONFIDENCE=0.58
UNCERTAINTY_MAX=0.18
RETRAIN_INTERVAL_HOURS=24

# --- Risk limits -----------------------------------------------------------
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_EXPOSURE_PCT=0.60
MAX_DAILY_LOSS_PCT=0.02
RISK_PER_TRADE_PCT=0.005
MAX_SPREAD_BPS=25.0
MIN_AVG_DOLLAR_VOLUME=5000000
MIN_ORDER_NOTIONAL=50
DUPLICATE_ORDER_WINDOW_MINUTES=60

# --- Infrastructure --------------------------------------------------------
DATABASE_PATH=data/stockbot.sqlite
MODEL_DIR=models_store
LOG_DIR=logs
LOG_LEVEL=INFO
TIMEZONE=America/New_York
SCHEDULER_INTERVAL_MINUTES=10
